{
  "realm": "reconq",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "browserFlow": "workspace-browser",
  "authenticationFlows": [
    {
      "id": "6b7a0f5c-5c8e-4f91-8b3a-7b6ef4d4d601",
      "alias": "workspace-browser",
      "description": "Password login plus single-use ReconQ workspace email links",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "workspace-token", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 0},
        {"authenticator": "auth-username-password-form", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 10}
      ]
    }
  ],
  "roles": {
    "realm": [
      { "name": "CFO", "description": "Full finance visibility and approval authority" },
      { "name": "Finance Manager", "description": "Runs reconciliation and submits journals" },
      { "name": "Accountant", "description": "Uploads data and prepares draft journals" },
      { "name": "Reviewer", "description": "Reviews exceptions and approves within threshold" },
      { "name": "Administrator", "description": "Manages users, entities, configuration, and access" },
      { "name": "Auditor", "description": "Read-only access with full audit visibility" }
    ]
  },
  "clients": [
    {
      "clientId": "reconq-frontend",
      "name": "ReconQ Frontend",
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "reconq-backend",
      "name": "ReconQ Backend",
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "CHANGE_ME_IN_DEPLOYMENT"
    }
  ]
}
